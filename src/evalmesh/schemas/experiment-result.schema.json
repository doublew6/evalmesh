{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evalmesh:schema:experiment-result:v1",
  "title": "EvalMesh experiment-result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "complete",
    "completed_jobs",
    "job_count",
    "planned_attempts",
    "reserved_attempts",
    "reporting_ok",
    "had_execution_errors",
    "passed",
    "jobs",
    "comparisons"
  ],
  "properties": {
    "schema_version": {
      "const": "evalmesh.experiment-result.v1"
    },
    "experiment_id": {
      "type": "string",
      "format": "uuid"
    },
    "complete": {
      "type": "boolean"
    },
    "completed_jobs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "job_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "planned_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "reserved_attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "reporting_ok": {
      "type": "boolean"
    },
    "had_execution_errors": {
      "type": "boolean"
    },
    "passed": {
      "type": "boolean"
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job_id",
          "subject_id",
          "suite_id",
          "suite_digest",
          "variant",
          "case_count",
          "repetitions",
          "attempt_count",
          "status"
        ],
        "properties": {
          "job_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "subject_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "suite_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "suite_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "variant": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 16,
            "required": [
              "id",
              "model_id",
              "reasoning_effort",
              "execution_id"
            ],
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          },
          "case_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "repetitions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "attempt_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "status": {
            "enum": [
              "pending",
              "interrupted",
              "error",
              "completed"
            ]
          },
          "summary": {
            "$ref": "urn:evalmesh:schema:summary:v1"
          },
          "reporting_ok": {
            "type": "boolean"
          },
          "token_usage": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000000000
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              }
            },
            "then": {
              "required": [
                "summary",
                "reporting_ok",
                "token_usage"
              ]
            }
          }
        ]
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "$ref": "urn:evalmesh:schema:comparison:v1"
      }
    }
  }
}
