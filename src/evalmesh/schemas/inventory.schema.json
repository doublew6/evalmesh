{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evalmesh:schema:inventory:v1",
  "title": "EvalMesh private monitoring inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "host_id", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "host_id": {"$ref": "#/$defs/hostId"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/asset"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "hostId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,122}$"
    },
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "asset": {
      "oneOf": [
        {"$ref": "#/$defs/pathAsset"},
        {"$ref": "#/$defs/gitAsset"},
        {"$ref": "#/$defs/skillAsset"},
        {"$ref": "#/$defs/automationFileAsset"},
        {"$ref": "#/$defs/automationDatabaseAsset"},
        {"$ref": "#/$defs/httpAsset"},
        {"$ref": "#/$defs/tcpAsset"},
        {"$ref": "#/$defs/launchdAsset"},
        {"$ref": "#/$defs/dockerAsset"}
      ]
    },
    "pathAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "path"},
        "tags": {"$ref": "#/$defs/tags"},
        "path": {"$ref": "#/$defs/path"},
        "path_type": {"enum": ["any", "directory", "file"], "default": "any"},
        "max_age_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 315576000
        }
      }
    },
    "gitAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "git"},
        "tags": {"$ref": "#/$defs/tags"},
        "path": {"$ref": "#/$defs/path"},
        "expected_revision": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{40,64}$"
        },
        "require_clean": {"type": "boolean", "default": false}
      }
    },
    "skillAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "skill"},
        "tags": {"$ref": "#/$defs/tags"},
        "path": {"$ref": "#/$defs/path"}
      }
    },
    "automationFileAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "automation"},
        "tags": {"$ref": "#/$defs/tags"},
        "path": {"$ref": "#/$defs/path"},
        "activity_path": {"$ref": "#/$defs/path"},
        "max_activity_age_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 315576000
        },
        "expected_status": {"enum": ["ACTIVE", "PAUSED"]}
      },
      "dependentRequired": {
        "activity_path": ["max_activity_age_seconds"],
        "max_activity_age_seconds": ["activity_path"]
      }
    },
    "automationDatabaseAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "database_path", "automation_id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "automation"},
        "tags": {"$ref": "#/$defs/tags"},
        "database_path": {"$ref": "#/$defs/path"},
        "automation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "activity_path": {"$ref": "#/$defs/path"},
        "max_activity_age_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 315576000
        },
        "expected_status": {"enum": ["ACTIVE", "PAUSED"]}
      },
      "dependentRequired": {
        "activity_path": ["max_activity_age_seconds"],
        "max_activity_age_seconds": ["activity_path"]
      }
    },
    "httpAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "url"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "http"},
        "tags": {"$ref": "#/$defs/tags"},
        "url": {"type": "string", "minLength": 1, "maxLength": 2048, "format": "uri"},
        "expected_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599,
          "default": 200
        }
      }
    },
    "tcpAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "host", "port"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "tcp"},
        "tags": {"$ref": "#/$defs/tags"},
        "host": {"enum": ["localhost", "127.0.0.1", "::1"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "launchdAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "launchd"},
        "tags": {"$ref": "#/$defs/tags"},
        "label": {"$ref": "#/$defs/label"},
        "expected_loaded": {"type": "boolean", "default": true},
        "expected_last_exit": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "not": {
        "required": ["expected_loaded", "expected_last_exit"],
        "properties": {"expected_loaded": {"const": false}}
      }
    },
    "dockerAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "docker"},
        "tags": {"$ref": "#/$defs/tags"},
        "name": {"$ref": "#/$defs/label"},
        "expected_running": {"type": "boolean", "default": true}
      }
    }
  }
}
