{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evalmesh:schema:experiment:v1",
  "title": "EvalMesh experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry",
    "projects",
    "profiles",
    "max_attempts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "max_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "dispatch_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "baseline": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "suites": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    }
  }
}
