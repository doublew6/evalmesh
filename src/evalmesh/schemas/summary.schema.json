{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evalmesh:schema:summary:v1",
  "title": "EvalMesh public evaluation summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "subject_id", "suite_id", "suite_digest",
    "variant", "case_count", "attempt_count", "passed_attempt_count",
    "attempt_pass_rate", "pass_at_1", "success_at_k", "stable_pass_at_k",
    "error_rate", "timeout_rate", "critical_case_count", "critical_failure_count",
    "passed", "status_counts", "reason_counts", "latency_ms", "metrics", "cases", "slices"
  ],
  "properties": {
    "schema_version": {"const": "evalmesh.summary.v1"},
    "batch_id": {"type": "string", "format": "uuid"},
    "subject_id": {"$ref": "#/$defs/id"},
    "suite_id": {"$ref": "#/$defs/id"},
    "suite_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "variant": {"$ref": "#/$defs/idMap"},
    "case_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "attempt_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "passed_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "attempt_pass_rate": {"$ref": "#/$defs/rate"},
    "pass_at_1": {"$ref": "#/$defs/rate"},
    "success_at_k": {"$ref": "#/$defs/rate"},
    "stable_pass_at_k": {"$ref": "#/$defs/rate"},
    "error_rate": {"$ref": "#/$defs/rate"},
    "timeout_rate": {"$ref": "#/$defs/rate"},
    "critical_case_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "critical_failure_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "passed": {"type": "boolean"},
    "status_counts": {"$ref": "#/$defs/countMap"},
    "reason_counts": {"$ref": "#/$defs/countMap"},
    "latency_ms": {"$ref": "#/$defs/distribution"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/case"}
    },
    "slices": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/slice"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "idMap": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/id"}
    },
    "countMap": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "minimum", "maximum", "mean", "p50", "p95"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "minimum": {"type": ["number", "null"]},
        "maximum": {"type": ["number", "null"]},
        "mean": {"type": ["number", "null"]},
        "p50": {"type": ["number", "null"]},
        "p95": {"type": ["number", "null"]}
      }
    },
    "metrics": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/distribution"}
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "tags", "dimensions", "attempt_count", "passed_attempt_count",
        "attempt_pass_rate", "pass_at_1", "success_at_k", "stable_pass_at_k",
        "status_counts", "reason_counts", "latency_ms", "metrics"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/id"}
        },
        "dimensions": {"$ref": "#/$defs/idMap"},
        "attempt_count": {"type": "integer", "minimum": 1, "maximum": 100},
        "passed_attempt_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "attempt_pass_rate": {"$ref": "#/$defs/rate"},
        "pass_at_1": {"type": "boolean"},
        "success_at_k": {"type": "boolean"},
        "stable_pass_at_k": {"type": "boolean"},
        "status_counts": {"$ref": "#/$defs/countMap"},
        "reason_counts": {"$ref": "#/$defs/countMap"},
        "latency_ms": {"$ref": "#/$defs/distribution"},
        "metrics": {"$ref": "#/$defs/metrics"}
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "name", "value", "case_count", "attempt_count",
        "passed_attempt_count", "attempt_pass_rate", "pass_at_1", "success_at_k",
        "stable_pass_at_k", "critical_failure_count"
      ],
      "properties": {
        "kind": {"enum": ["tag", "dimension"]},
        "name": {"$ref": "#/$defs/id"},
        "value": {"$ref": "#/$defs/id"},
        "case_count": {"type": "integer", "minimum": 1},
        "attempt_count": {"type": "integer", "minimum": 1},
        "passed_attempt_count": {"type": "integer", "minimum": 0},
        "attempt_pass_rate": {"$ref": "#/$defs/rate"},
        "pass_at_1": {"$ref": "#/$defs/rate"},
        "success_at_k": {"$ref": "#/$defs/rate"},
        "stable_pass_at_k": {"$ref": "#/$defs/rate"},
        "critical_failure_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
