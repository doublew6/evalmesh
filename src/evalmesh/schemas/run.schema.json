{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evalmesh:schema:run:v1",
  "title": "EvalMesh PublicRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "subject_id", "suite_id", "suite_digest",
    "case_id", "attempt", "tags", "target_kind", "started_at", "completed_at",
    "duration_ms", "status", "passed", "aggregate_score", "capture",
    "policy_version", "redaction_version", "case_input", "case_expected",
    "execution", "scores"
  ],
  "properties": {
    "schema_version": {"const": "evalmesh.run.v1"},
    "run_id": {"type": "string", "format": "uuid"},
    "subject_id": {"$ref": "#/$defs/id"},
    "suite_id": {"$ref": "#/$defs/id"},
    "suite_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "case_id": {"$ref": "#/$defs/id"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 100},
    "tags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "target_kind": {"enum": ["command", "http", "codex"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "status": {"enum": ["passed", "failed", "error", "timeout"]},
    "passed": {"type": "boolean"},
    "aggregate_score": {"type": "number", "minimum": 0, "maximum": 1},
    "capture": {"enum": ["digest", "redacted"]},
    "policy_version": {"const": "evalmesh.privacy.v1"},
    "redaction_version": {"const": "evalmesh.redaction.v1"},
    "case_input": {"$ref": "#/$defs/contentView"},
    "case_expected": {"$ref": "#/$defs/contentView"},
    "execution": {"$ref": "#/$defs/execution"},
    "scores": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/score"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "contentView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_id", "byte_count", "hmac_sha256", "truncated"],
      "properties": {
        "content_id": {"type": "string", "format": "uuid"},
        "byte_count": {"type": "integer", "minimum": 0},
        "hmac_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "value": true,
        "truncated": {"type": "boolean"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_path", "exists", "size_bytes", "content"],
      "properties": {
        "logical_path": {"type": "string", "pattern": "^workspace://"},
        "exists": {"type": "boolean"},
        "size_bytes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "content": {"oneOf": [{"$ref": "#/$defs/contentView"}, {"type": "null"}]}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
        "event_counts": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "thread.started", "turn.started", "turn.completed", "turn.failed",
              "item.started", "item.updated", "item.completed", "error", "unknown"
            ]
          },
          "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 1000000}
        },
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000},
            "cached_input_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000},
            "output_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000},
            "reasoning_output_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000}
          },
          "additionalProperties": false
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output", "stdout", "stderr", "metrics", "artifacts", "error_codes", "metadata"],
      "properties": {
        "output": {"$ref": "#/$defs/contentView"},
        "stdout": {"$ref": "#/$defs/contentView"},
        "stderr": {"$ref": "#/$defs/contentView"},
        "metrics": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"type": "number"}
        },
        "artifacts": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "error_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "adapter_invalid_result", "adapter_unhandled_error", "artifact_unreadable",
              "artifact_unsafe", "codex_turn_failed", "executable_not_found",
              "http_request_failed", "http_status_error", "invalid_codex_event",
              "invalid_json_output", "invalid_metric", "invalid_metrics_object",
              "invalid_utf8_output", "missing_codex_final_message", "missing_codex_prompt",
              "missing_codex_turn_completed",
              "pipe_drain_incomplete", "stderr_truncated", "stdin_delivery_incomplete",
              "stdout_truncated", "target_start_failed", "target_timeout",
              "unclassified_target_error", "unsupported_process_platform"
            ]
          }
        },
        "metadata": {"$ref": "#/$defs/metadata"}
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grader_id", "grader_type", "status", "value", "threshold", "passed",
        "weight", "required", "reason_code"
      ],
      "properties": {
        "grader_id": {"$ref": "#/$defs/id"},
        "grader_type": {
          "enum": [
            "exit_code", "json_equals", "contains", "regex", "metric_threshold",
            "precomputed_score", "latency", "file_exists", "file_contains", "file_json_equals"
          ]
        },
        "status": {"enum": ["scored", "error", "skipped"]},
        "value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "passed": {"type": "boolean"},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "required": {"type": "boolean"},
        "reason_code": {
          "enum": [
            "actual_path_missing", "actual_too_large", "actual_type_invalid",
            "artifact_checked", "artifact_missing", "artifact_truncated",
            "case_not_selected", "containment_checked", "equality_checked",
            "exit_code_checked", "expected_missing", "expected_type_invalid",
            "grader_config_invalid", "grader_input_invalid", "grader_result_invalid",
            "latency_checked", "metric_missing", "metric_out_of_range",
            "metric_threshold_checked", "pattern_checked", "precomputed_score_used",
            "regex_timeout", "rule_evaluated", "target_result_unavailable"
          ]
        }
      }
    }
  }
}
