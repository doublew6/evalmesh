{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evalmesh:schema:case:v1",
  "title": "EvalMesh case JSONL row",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "input", "expected"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "input": true,
    "expected": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/id"}
    },
    "grader_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
  }
}
