# Values are intentionally blank. EvalMesh never reads .env files automatically.
# Export only the variables required by the adapter you are running.

# Optional keyed content fingerprints. Use a high-entropy local secret.
EVALMESH_HMAC_KEY=

# OpikReporter fails closed unless an explicit endpoint is provided.
# For an Opik instance on the same host, the runner should normally use loopback.
EVALMESH_OPIK_URL=http://127.0.0.1:5173/api
EVALMESH_OPIK_WORKSPACE=default
EVALMESH_OPIK_PROJECT=
EVALMESH_OPIK_API_KEY=

# Set this in the Opik self-host deployment environment, not in EvalMesh itself.
OPIK_USAGE_REPORT_ENABLED=false

# Optional generic private workspace location used by target.workspace_path_env.
# Do not put a real path in this tracked file.
EVALMESH_TARGET_WORKSPACE=
